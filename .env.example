# Copy this file to ".env" and fill in what you need. Every variable is optional.

# Public URL of the deployed site. Used for Open Graph, sitemap and canonical URLs.
# Example: https://sampath.vercel.app
NEXT_PUBLIC_SITE_URL=""

# --- Contact form (optional) ---------------------------------------------------
# The form sends mail through Resend (https://resend.com). Without these values the
# form shows a friendly message and points visitors to your email address instead.
RESEND_API_KEY=""
# Where messages are delivered (your inbox).
CONTACT_TO_EMAIL=""
# Verified sender, e.g. "Portfolio <contact@yourdomain.com>".
# For quick tests Resend allows: "Portfolio <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=""
